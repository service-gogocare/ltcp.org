# 儲存層選擇
#   firestore（預設）我方 Firestore，帳號密碼登入
#   sheets            各機構自己的 Google 試算表，Google 登入
# 未設定時一律使用 firestore，維持現況。
VITE_BACKEND=firestore

# --- VITE_BACKEND=firestore 時需要 ---
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# --- VITE_BACKEND=sheets 時需要 ---
# Google Cloud Console 建立的「OAuth 2.0 用戶端 ID（網頁應用程式）」，
# 授權的 JavaScript 來源要包含正式網域與 http://localhost:5173。
# 純前端流程不需要 client secret。
VITE_GOOGLE_CLIENT_ID=your_oauth_client_id_here.apps.googleusercontent.com

# Google Cloud Console 建立的「API 金鑰」，供 Google Picker 使用
# （與上面的用戶端 ID 是兩回事，兩者都需要）。
# 建議在金鑰設定裡限制「HTTP 參照網址」為你的網域與 http://localhost:5173/*，
# 並限制只能使用 Google Picker API。
# 沒有這個金鑰時，「開啟分享給我的名冊」會明確提示缺少設定，其餘功能不受影響。
VITE_GOOGLE_API_KEY=your_api_key_here
