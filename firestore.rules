rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    // 讀取呼叫者自己的 users 文件。
    // 注意：一律以 `||` 短路的方式擺在「本人判斷」之後使用，
    // 這樣本人操作不會觸發這次 get()，註冊當下自己的文件還不存在也不會被誤判為拒絕。
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 可管理全系統（可跨機構寫入）
    function isAdmin() {
      let role = profile().role;
      return role == 'admin' || role == 'super_admin';
    }

    // 可查看全系統（含唯讀稽查員）
    function isOverseer() {
      let role = profile().role;
      return role == 'admin' || role == 'super_admin' || role == 'auditor';
    }

    // 以下兩個函式各自只呼叫一次 profile()，
    // 避免像舊版那樣在同一條規則裡重複 get() 造成額外計費讀取。
    function canReadOrg(orgId) {
      let p = profile();
      return p.orgId == orgId
        || p.role == 'admin'
        || p.role == 'super_admin'
        || p.role == 'auditor';
    }

    function canWriteOrg(orgId) {
      let p = profile();
      return p.orgId == orgId
        || p.role == 'admin'
        || p.role == 'super_admin';
    }

    // 稽核日誌只接受固定的五個欄位，且 operatorEmail 必須是發出請求者本人，
    // 避免任何登入者偽造他人名義的日誌，或塞入超長 / 非預期內容。
    function isValidAuditLog() {
      let d = request.resource.data;
      let fields = ['timestamp', 'operatorEmail', 'action', 'targetOrgId', 'details'];
      return d.keys().hasOnly(fields)
        && d.keys().hasAll(fields)
        && d.operatorEmail == request.auth.token.email
        && d.timestamp is string
        && d.operatorEmail is string
        && d.action is string
        && d.targetOrgId is string
        && d.details is string
        && d.timestamp.size() > 0 && d.timestamp.size() <= 40
        && d.action.size() > 0 && d.action.size() <= 200
        && d.targetOrgId.size() <= 100
        && d.details.size() <= 2000;
    }

    // ── 使用者 / 機構主檔 ────────────────────────────────
    match /users/{userId} {
      // 單筆讀取：只能讀自己的檔；管理員與稽查員可讀他人
      allow get: if isLoggedIn() && (request.auth.uid == userId || isOverseer());

      // 列表查詢（管理面板的機構清單）：僅管理員與稽查員。
      // 一般機構用戶列出整個 users 集合會被拒絕，
      // 避免跨機構取得其他機構的 email / orgId / role。
      allow list: if isLoggedIn() && isOverseer();

      // 建立：
      //   本人建自己的檔（registerUser 註冊、以及 loginUser 發現無檔時補建）
      //   —— 角色只能是 'user'，email 必須是自己的，不得自封管理員。
      //   管理員代建其他機構帳號（adminCreateOrg）則不受此限。
      // 本人條件擺在 isAdmin() 前面短路：註冊當下自己的檔還不存在，
      // 先跑 isAdmin() 會因為 get() 讀不到而被誤拒。
      allow create: if isLoggedIn() && (
        (
          request.auth.uid == userId
          && request.resource.data.role == 'user'
          && request.resource.data.email.lower() == request.auth.token.email.lower()
        )
        || isAdmin()
      );

      // 更新：
      //   本人只能改顯示名稱。舊版是 `uid == userId || isAdmin()` 的整份放行，
      //   機構帳號可以把自己的 role 改成 admin 取得跨機構權限，或把 orgId
      //   改成別家機構的 ID 直接讀寫對方的小卡（canReadOrg/canWriteOrg 只比對
      //   orgId 欄位）。用 affectedKeys 白名單而不是逐欄比對，是因為部分帳號
      //   沒有 status 欄位，比對不存在的欄位會讓規則求值失敗。
      allow update: if isLoggedIn() && (
        (
          request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        )
        || isAdmin()
      );

      // 刪除：只有管理員（機構帳號不該能刪掉自己的主檔，那會讓資料變成孤兒）
      allow delete: if isLoggedIn() && isAdmin();
    }

    // ── 各機構的學員小卡 ────────────────────────────────
    match /organizations/{orgId}/student_cards/{studentId} {
      allow read: if isLoggedIn() && canReadOrg(orgId);
      allow write: if isLoggedIn() && canWriteOrg(orgId);
    }

    // ── 稽核日誌 ──────────────────────────────────────
    match /audit_logs/{logId} {
      // 讀取（含列表）：僅管理員
      allow read: if isLoggedIn() && isAdmin();

      // 任何登入者都會產生日誌（例如機構用戶刪除自己機構的小卡），
      // 但內容必須通過驗證，且不能冒用他人的 operatorEmail
      allow create: if isLoggedIn() && isValidAuditLog();

      // 日誌為 append-only：寫入後不得修改或刪除
      allow update, delete: if false;
    }
  }
}
